# Copy this file to .env and fill in your values

# Soundbored API Configuration
# Use the Soundbored site URL or the /api URL. The proxy normalizes either form.
SOUNDBORED_API_URL=https://your-soundboard-url.com
# Create a personal API token in Soundbored Settings.
SOUNDBORED_API_TOKEN=your-personal-api-token-here

# Server Configuration (optional)
PORT=3000
